/* --- БАЗОВЫЕ СТИЛИ --- */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    -webkit-font-smoothing: antialiased;
    -webkit-tap-highlight-color: transparent;
}

body, html {
    width: 100%;
    height: 100%;
    overflow: hidden !important;
    background-color: #F9F5F0; /* тёплый крем */
    font-family: 'Jost', sans-serif;
    color: #4A4A4A;
}

/* Сцены */
.scene {
    position: fixed;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    opacity: 0;
    visibility: hidden;
    z-index: 1;
    transition: opacity 1.2s cubic-bezier(0.25, 1, 0.3, 1),
                visibility 1.2s,
                transform 1.2s cubic-bezier(0.25, 1, 0.3, 1);
    transform: scale(1.05);
    filter: blur(8px);
    overflow: hidden;
}

.scene.active {
    opacity: 1;
    visibility: visible;
    z-index: 2;
    transform: scale(1);
    filter: blur(0);
}

/* Кнопка "Дальше" общая */
.btn-gallery-next {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: linear-gradient(135deg, #D4A5A5, #B08D57);
    color: #fff;
    border: none;
    padding: 14px 32px;
    border-radius: 50px;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    cursor: pointer;
    transition: transform 0.3s, box-shadow 0.3s;
    box-shadow: 0 10px 30px rgba(212,165,165,0.3);
}

.btn-gallery-next:active {
    transform: scale(0.95);
}

/* --- СЦЕНА 1: ОБЛОЖКА --- */
.cover-container {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    background: radial-gradient(circle at 50% 40%, #F9F5F0, #F0E6E0);
}

.cover-ornament {
    text-align: center;
    position: relative;
    max-width: 320px;
    padding: 30px;
}

.cover-ornament svg {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    opacity: 0.3;
    pointer-events: none;
}

.cover-badge {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 4px;
    color: #B08D57;
    display: block;
    margin-bottom: 20px;
}

.cover-names {
    font-family: 'Playfair Display', serif;
    font-size: 3.2rem;
    color: #4A4A4A;
    line-height: 1.1;
}

.cover-names .name-block {
    display: block;
}

.cover-names .ampersand {
    font-style: italic;
    font-size: 2rem;
    color: #B08D57;
    margin: 8px 0;
}

.cover-date {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.2rem;
    color: #8C7A6B;
    letter-spacing: 2px;
    margin: 30px 0;
}

.btn-cover {
    background: transparent;
    border: 1px solid #B08D57;
    color: #B08D57;
    padding: 14px 36px;
    border-radius: 50px;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    cursor: pointer;
    transition: all 0.3s;
}

.btn-cover:active {
    background: #B08D57;
    color: #fff;
}

/* --- СЦЕНА 2: АКВАРЕЛЬНАЯ ИСТОРИЯ --- */
.story-slides {
    position: relative;
    width: 100%;
    height: 100%;
}

.story-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1s ease;
    display: flex;
    align-items: center;
    justify-content: center;
}

.story-slide.active {
    opacity: 1;
}

.story-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    filter: brightness(0.7) blur(2px);
    transform: scale(1.05);
}

.story-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0.1), rgba(0,0,0,0.5));
}

.story-caption {
    position: relative;
    z-index: 2;
    max-width: 80%;
    text-align: center;
    color: #fff;
}

.story-text {
    font-family: 'Playfair Display', serif;
    font-size: 1.4rem;
    line-height: 1.4;
    text-shadow: 0 2px 10px rgba(0,0,0,0.3);
}

.story-prev, .story-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: rgba(255,255,255,0.7);
    font-size: 2.5rem;
    cursor: pointer;
    z-index: 10;
    padding: 20px;
}

.story-prev { left: 10px; }
.story-next { right: 10px; }

.story-dots {
    position: absolute;
    bottom: 100px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 10px;
    z-index: 10;
}

.dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255,255,255,0.4);
    cursor: pointer;
}

.dot.active {
    background: #fff;
    transform: scale(1.3);
}

/* --- СЦЕНА 3: ПОЛЯРОИДНАЯ ТЕНЬ --- */
.gallery-container {
    height: 100%;
    background: #F9F5F0;
    padding: 30px 20px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.gallery-header {
    text-align: center;
    margin-bottom: 30px;
}

.gallery-subtitle {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 4px;
    color: #B08D57;
}

.gallery-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.8rem;
    margin: 5px 0;
    color: #4A4A4A;
}

.gallery-tip {
    font-size: 0.75rem;
    color: #8C7A6B;
}

.gallery-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    width: 100%;
    max-width: 360px;
    margin-bottom: 30px;
}

.gallery-item {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 10px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    cursor: pointer;
}

.photo-blur {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    filter: blur(8px) brightness(0.8);
    transition: filter 0.8s ease;
}

.gallery-item.revealed .photo-blur {
    filter: blur(0) brightness(1);
}

.photo-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 8px 12px;
    background: linear-gradient(to top, rgba(0,0,0,0.6), transparent);
    color: #fff;
    font-size: 0.75rem;
    opacity: 0;
    transition: opacity 0.5s;
}

.gallery-item.revealed .photo-caption {
    opacity: 1;
}

/* --- СЦЕНА 4: ПРИГЛАШЕНИЕ-СВИТОК --- */
.scroll-container {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #F0E6E0;
    padding: 20px;
    position: relative;
}

.scroll-paper {
    width: 100%;
    max-width: 320px;
    background: #FDF8F4;
    border-radius: 4px;
    padding: 40px 24px;
    box-shadow: 0 15px 50px rgba(0,0,0,0.15);
    text-align: center;
    position: relative;
    z-index: 2;
}

.scroll-inner {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 1s ease 0.5s, transform 1s ease 0.5s;
}

.scroll-container.active .scroll-inner {
    opacity: 1;
    transform: translateY(0);
}

.scroll-subtitle {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 4px;
    color: #B08D57;
}

.scroll-names {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    margin: 15px 0;
    color: #4A4A4A;
}

.scroll-divider {
    width: 60px;
    height: 1px;
    background: linear-gradient(to right, transparent, #B08D57, transparent);
    margin: 15px auto;
}

.scroll-invitation {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1rem;
    line-height: 1.5;
    color: #6B5B4E;
}

.scroll-date-box {
    display: flex;
    justify-content: center;
    margin: 25px 0;
    border-top: 1px solid rgba(176,141,87,0.3);
    border-bottom: 1px solid rgba(176,141,87,0.3);
    padding: 10px 0;
}

.date-item {
    padding: 0 20px;
}

.date-item.border-left {
    border-left: 1px solid rgba(176,141,87,0.3);
}

.date-num {
    font-family: 'Playfair Display', serif;
    font-size: 1.6rem;
    display: block;
    color: #B08D57;
}

.date-month {
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #8C7A6B;
}

.scroll-location {
    margin: 20px 0;
}

.loc-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.2rem;
    display: block;
    color: #4A4A4A;
}

.loc-details {
    font-size: 0.65rem;
    color: #8C7A6B;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.btn-scroll-next {
    background: linear-gradient(135deg, #D4A5A5, #B08D57);
    border: none;
    color: #fff;
    padding: 12px 26px;
    border-radius: 50px;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    margin-top: 20px;
    transition: transform 0.3s;
}

.btn-scroll-next:active {
    transform: scale(0.95);
}

/* Декоративные ручки свитка (древки) */
.scroll-handle {
    position: absolute;
    width: 80px;
    height: 300px;
    background: linear-gradient(to right, #C9A86A, #E0C58E, #C9A86A);
    border-radius: 10px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.2);
}

.scroll-handle-left {
    left: 10%;
    transform: rotate(90deg);
    transform-origin: center;
}

.scroll-handle-right {
    right: 10%;
    transform: rotate(90deg);
    transform-origin: center;
}

/* --- СЦЕНА 5: RSVP --- */
.rsvp-container {
    width: 100%;
    max-width: 400px;
    margin: 0 auto;
    padding: 40px 20px;
    height: 100%;
    overflow-y: auto;
    background: #F9F5F0;
}

.rsvp-header {
    text-align: center;
    margin-bottom: 30px;
}

.rsvp-subtitle {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: #B08D57;
}

.rsvp-text {
    font-size: 0.85rem;
    color: #8C7A6B;
    margin-top: 10px;
}

.rsvp-form {
    display: flex;
    flex-direction: column;
    gap: 25px;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.group-label {
    font-size: 0.9rem;
    font-weight: 500;
    color: #4A4A4A;
}

.radio-tiles {
    display: flex;
    gap: 12px;
}

.tile-card {
    flex: 1;
    position: relative;
    cursor: pointer;
}

.tile-card input[type="radio"] {
    position: absolute;
    opacity: 0;
}

.tile-content {
    border: 1px solid #D4A5A5;
    padding: 14px;
    text-align: center;
    border-radius: 8px;
    background: #fff;
    transition: all 0.3s;
}

.tile-card input[type="radio"]:checked + .tile-content {
    background: #D4A5A5;
    border-color: #D4A5A5;
}

.tile-card input[type="radio"]:checked + .tile-content .tile-title {
    color: #fff;
}

.tile-title {
    font-size: 0.85rem;
    font-weight: 500;
    color: #4A4A4A;
}

.rsvp-input {
    width: 100%;
    padding: 14px;
    border: 1px solid #D2CBC0;
    background: #fff;
    border-radius: 8px;
    font-size: 0.9rem;
    outline: none;
    transition: border-color 0.3s;
}

.rsvp-input:focus {
    border-color: #B08D57;
}

.checkbox-tiles {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.tile-card-check {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #fff;
    padding: 12px 14px;
    border-radius: 8px;
    border: 1px solid #D2CBC0;
    cursor: pointer;
    position: relative;
}

.tile-card-check input[type="checkbox"] {
    position: absolute;
    opacity: 0;
}

.check-custom {
    width: 18px;
    height: 18px;
    border: 1px solid #B08D57;
    border-radius: 50%; /* круглый, как лепесток */
    position: relative;
    transition: all 0.3s;
}

.tile-card-check input[type="checkbox"]:checked + .check-custom {
    background: #B08D57;
    box-shadow: inset 0 0 0 3px #fff;
}

.check-text {
    font-size: 0.85rem;
    color: #4A4A4A;
}

.btn-rsvp-submit {
    background: #234137;
    color: #fff;
    border: none;
    padding: 15px;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    border-radius: 50px;
    cursor: pointer;
    transition: background 0.3s;
}

.btn-rsvp-submit:active {
    background: #162a23;
}

.rsvp-success-message {
    text-align: center;
    padding: 40px 20px;
}

.success-icon {
    font-size: 3rem;
    margin-bottom: 15px;
}

/* --- СЦЕНА 6: ТАЙМЕР --- */
.timer-container {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle at 50% 50%, #F9F5F0, #F0E6E0);
    padding: 20px;
    position: relative;
    overflow: hidden;
}

.timer-petals {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: radial-gradient(circle, rgba(212,165,165,0.3) 2px, transparent 2px);
    background-size: 30px 30px;
    animation: petalsFloat 15s infinite linear;
    opacity: 0.4;
    pointer-events: none;
}

@keyframes petalsFloat {
    0% { transform: translateY(0); }
    50% { transform: translateY(-20px); }
    100% { transform: translateY(0); }
}

.timer-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.6rem;
    color: #4A4A4A;
    margin-bottom: 20px;
}

.wedding-timer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    max-width: 320px;
    background: rgba(255,255,255,0.6);
    border-radius: 20px;
    padding: 20px;
    backdrop-filter: blur(10px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
}

.timer-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 55px;
}

.timer-number {
    font-family: 'Playfair Display', serif;
    font-size: 2.5rem;
    color: #B08D57;
    line-height: 1;
}

.timer-label {
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #8C7A6B;
    margin-top: 5px;
}

.timer-separator {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    color: #D4A5A5;
    margin-bottom: 15px;
}

.timer-divider {
    width: 50px;
    height: 1px;
    background: #B08D57;
    margin: 30px auto;
}

.hashtag-box {
    background: #fff;
    border: 1px dashed #B08D57;
    padding: 14px 24px;
    border-radius: 30px;
}

.hashtag-label {
    display: block;
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #8C7A6B;
    margin-bottom: 5px;
}

.hashtag-value {
    font-family: 'Playfair Display', serif;
    font-size: 1.2rem;
    color: #4A4A4A;
    font-weight: 500;
}

/* --- СЦЕНА 7: ФИНАЛ --- */
.final-container {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: linear-gradient(to bottom, #F9F5F0, #F0E6E0);
    padding: 30px;
    text-align: center;
}

.final-flower {
    font-size: 4rem;
    margin-bottom: 20px;
    animation: flowerPulse 3s infinite;
}

@keyframes flowerPulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
}

.final-title {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    color: #4A4A4A;
    line-height: 1.2;
    margin-bottom: 15px;
}

.final-text {
    font-size: 0.9rem;
    color: #8C7A6B;
    margin-bottom: 30px;
}

.btn-final {
    background: transparent;
    border: 1px solid #B08D57;
    color: #B08D57;
    padding: 12px 30px;
    border-radius: 50px;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.3s;
}

.btn-final:active {
    background: #B08D57;
    color: #fff;
}
